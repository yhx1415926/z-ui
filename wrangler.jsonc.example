// Cloudflare Workers deployment (free plan). See README → "部署到 Cloudflare".
// Fill in the three values marked TODO, then: npm run cf:deploy
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "z-ui",
	"main": "apps/api/src/worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Only /api/* runs the Worker. Everything else (the app, /bin/*.json lookup files) is a static
	// asset: free, unlimited, and not counted against the 100k Worker requests per day.
	"assets": {
		"directory": "./apps/web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "z-ui",
			"database_id": "a61eb056-8696-4d17-b1f1-de5edc5b94b0",
			"migrations_dir": "apps/api/src/db/migrations"
		}
	],
	// Per-IP throttle for login / passkey / setup endpoints (no D1 writes needed).
	"ratelimits": [
		{
			"name": "AUTH_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60
			}
		}
	],
	// TODO: your domain. A custom domain route makes Cloudflare create the DNS record + certificate.
	"routes": [
		{
			"pattern": "z-ui.example.com",
			"custom_domain": true
		}
	],
	// Scheduled jobs (free plan): daily 01:00 UTC = 09:00 China time (automatic credit card
	// repayments + notification emails), and every 30 min during US market hours (price alerts).
	"triggers": {
		"crons": [
			"0 1 * * *",
			"*/30 13-21 * * 1-5"
		]
	},
	// Email notifications: first enable Email Routing on your domain and verify your private inbox
	// as a destination address (Cloudflare dashboard → your domain → Email → Email Routing), then
	// remove the // in front of the three lines below and deploy again.
	//"send_email": [
	//	{ "name": "MAILER" }
	//],
	// The *.workers.dev URL stays off so the only entrance is your (Access-protected) domain.
	"workers_dev": false,
	"preview_urls": false,
	"vars": {
		// TODO: the same domain (WebAuthn relying party id + allowed browser origin).
		"RP_ID": "z-ui.example.com",
		"ORIGINS": "https://z-ui.example.com",
		"RP_NAME": "Z-UI",
		"COOKIE_SECURE": "true",
		"TRUST_PROXY": "true",
		// PBKDF2 cost for new password hashes: 50k ≈ 3–4 ms, within the free plan's 10 ms CPU.
		"PASSWORD_ITERATIONS": "50000"
	},
	// Secrets (never in this file): npx wrangler secret put APP_ENC_KEY | SESSION_PEPPER | SETUP_TOKEN
	// Optional: FINNHUB_API_KEY (stock quotes; Yahoo Finance is used without it).
	"observability": {
		"enabled": false
	}
}